@using CommunityToolkit.Mvvm.Messaging
@using NexusForever.SpellWorks.Core.Messages
@implements IDisposable
@inject WorkspaceState State
@inject RowSource Rows
@inject FilterSchemaRegistry Schemas
@inject ITableCatalog Catalog
@inject IEngineHost Engine
@inject ISpellModelService Models
@inject ITextTableService Text
@inject IPopoutHost Popouts
@inject IInstallationProbe Probe
@inject IFolderPicker FolderPicker
@inject WorkspaceStore Store
@inject IMessenger Messenger
@inject IJSRuntime Js

@* A pop-out owns its own filter set, Data/Filter mode and Lock, but shares the selected spell and history. *@
<CascadingValue Value="_ctx" IsFixed="false">
<div class="popout-root" @onmousedown="DismissMenu">

    <div class="popout-title" @onmousedown="BeginWindowDrag">
        <i class="@_descriptor.Icon"></i>
        <span class="label" title="@_descriptor.Title">@_descriptor.Title</span>
        <span class="meta" title="@_descriptor.Meta">@_descriptor.Meta</span>
        <div class="pane-flex"></div>

        <div class="window-buttons" @onmousedown:stopPropagation="true">
            @if (_descriptor.Kind != PaneKind.Setup)
            {
                <div class="segmented">
                    <button type="button" class="@(Pane.Mode == PaneMode.Rows ? "on" : null)" @onclick="() => SetMode(PaneMode.Rows)">Data</button>
                    <button type="button" class="@(Pane.Mode == PaneMode.Filter ? "on" : null)" @onclick="() => SetMode(PaneMode.Filter)">
                        Filter
                        @if (FilterCount > 0)
                        {
                            <span class="badge">@FilterCount</span>
                        }
                    </button>
                </div>
            }
            <button type="button" class="title-btn" title="Dock back into main window" @onclick="Dock">
                <i class="ph ph-arrow-square-in"></i>
            </button>
            <button type="button" class="title-btn" title="Minimize" @onclick="() => Bridge.Minimize()">
                <i class="ph ph-minus"></i>
            </button>
            <button type="button" class="title-btn close" title="Close window" @onclick="() => Bridge.Close()">
                <i class="ph ph-x"></i>
            </button>
        </div>
    </div>

    <Pane Descriptor="_descriptor" Scope="@PaneKey" Generation="_generation" />
</div>

<ContextMenu Model="_ctx.Menu" Closed="() => StateHasChanged()" />
</CascadingValue>

@code {
    [Parameter] public IWindowBridge Bridge { get; set; }
    [Parameter] public string PaneKey { get; set; }
    [Parameter] public string ViewId { get; set; }

    private ShellContext _ctx;
    private DotNetObjectReference<PopoutRoot> _self;
    private IJSObjectReference _module;
    private PaneDescriptor _descriptor;
    private int _generation;

    protected override void OnInitialized()
    {
        _descriptor = State.Describe(ViewId);

        _ctx = new ShellContext
        {
            State     = State,
            Rows      = Rows,
            Schemas   = Schemas,
            Catalog   = Catalog,
            Engine    = Engine,
            Models    = Models,
            Text      = Text,
            Popouts   = Popouts,
            Store     = Store,
            Bridge    = Bridge,
            Probe     = Probe,
            FolderPicker = FolderPicker,
            Refresh   = () => InvokeAsync(StateHasChanged),
            IsPopout  = true,
            PopoutKey = PaneKey
        };

        State.Changed += OnStateChanged;

        Messenger.Register<SpellSelectedMessage>(this, (_, _) => _ = InvokeAsync(StateHasChanged));
        Messenger.Register<SpellHyperlinkClicked>(this, (_, _) => _ = InvokeAsync(StateHasChanged));
        // Everything the handler touches goes through InvokeAsync, not just the render: _generation and
        // _descriptor are read by this component's markup, and Describe writes into WorkspaceState's own
        // descriptor cache. The sender happens to be on the dispatcher, but the rule a message handler
        // has to keep is that it does not touch render state directly.
        Messenger.Register<SpellResourcesLoaded>(this, (_, _) => _ = InvokeAsync(() =>
        {
            _generation++;
            _descriptor = State.Describe(ViewId);

            StateHasChanged();
        }));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/shell.js");
        _ctx.Js = _module;

        _self = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("registerHotkeys", _self);

        StateHasChanged();
    }

    private PaneState Pane => State.PaneStateFor(PaneKey);

    private int FilterCount => _ctx.FilterCount(PaneKey, _descriptor);

    private void SetMode(PaneMode mode)
    {
        Pane.Mode = mode;
        State.Notify();
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void BeginWindowDrag(MouseEventArgs e)
    {
        DismissMenu();

        if (e.Detail >= 2)
            Bridge.ToggleMaximize();
        else
            Bridge.BeginDrag();
    }

    private void Dock() => Popouts.Dock(PaneKey);

    private void DismissMenu()
    {
        if (_ctx.Menu == null)
            return;

        _ctx.CloseMenu();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnHotkey(string key, bool shift)
    {
        // A pop-out has no palette of its own; Esc dismisses its context menu.
        if (key is "escape" && _ctx.Menu != null)
        {
            _ctx.CloseMenu();
            StateHasChanged();
            return;
        }

        if (key is "down" or "up" && _ctx.Menu is { } menu && menu.Items.Count > 0)
        {
            menu.Cursor = (menu.Cursor + (key == "down" ? 1 : -1) + menu.Items.Count) % menu.Items.Count;
            StateHasChanged();
            return;
        }

        if (key is "enter" && _ctx.Menu is { Cursor: >= 0 } open)
        {
            open.Items.ElementAtOrDefault(open.Cursor)?.Invoke();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnSplitDragged(double[] flexes)
    {
        // A pop-out never splits; the callback exists so the shared module has one shape.
    }

    [JSInvokable]
    public void OnPinDropped(string viewId, string mode)
    {
    }

    [JSInvokable]
    public void OnWindowBlur()
    {
        if (_ctx.Menu == null)
            return;

        _ctx.CloseMenu();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Messenger.UnregisterAll(this);
        _self?.Dispose();
    }
}
